# terain-mars/green-house/gh-grow-dsp.ic10
# Updates greenhouse tray LEDs to reflect hydroponics growth state and readiness.
# Tray states: 3 = growth, 4 = ready, 5 = seeding.
define LISTxTRAYSxADDR 100
alias Count r0
alias Tray.rid r1
alias Led.rid r2
alias Clr r3
alias Return r4

move Count 0
jal setupTrays

main:
    jal updateLeds
    sleep 5
j main

discoverTrays:
    lbn r15 HASH("StructureHydroponicsTrayData") Tray.rid ReferenceId Minimum
    push r15 
    lbn r15 HASH("ModularDeviceLightSmall") Led.rid ReferenceId Minimum
    push r15 
j ra

setupTrays:
    move Return ra
    move sp LISTxTRAYSxADDR
    move Count sp
    move Tray.rid HASH("ch2-tr11-dev")
    move Led.rid HASH("ch2-tr11-led")
    jal discoverTrays
    move Tray.rid HASH("ch2-tr12-dev")
    move Led.rid HASH("ch2-tr12-led")
    jal discoverTrays
    move Tray.rid HASH("ch2-tr13-dev")
    move Led.rid HASH("ch2-tr13-led")
    jal discoverTrays
    move Tray.rid HASH("ch2-tr14-dev")
    move Led.rid HASH("ch2-tr14-led")
    jal discoverTrays
    move Tray.rid HASH("ch2-tr21-dev")
    move Led.rid HASH("ch2-tr21-led")
    jal discoverTrays
    move Tray.rid HASH("ch2-tr22-dev")
    move Led.rid HASH("ch2-tr22-led")
    jal discoverTrays
    move Tray.rid HASH("ch2-tr23-dev")
    move Led.rid HASH("ch2-tr23-led")
    jal discoverTrays
    move Tray.rid HASH("ch2-tr24-dev")
    move Led.rid HASH("ch2-tr24-led")
    jal discoverTrays
    move Tray.rid HASH("ch2-tr31-dev")
    move Led.rid HASH("ch2-tr31-led")
    jal discoverTrays
    move Tray.rid HASH("ch2-tr32-dev")
    move Led.rid HASH("ch2-tr32-led")
    jal discoverTrays
    move Tray.rid HASH("ch2-tr33-dev")
    move Led.rid HASH("ch2-tr33-led")
    jal discoverTrays
    move Tray.rid HASH("ch2-tr34-dev")
    move Led.rid HASH("ch2-tr34-led")
    jal discoverTrays
    move Tray.rid HASH("ch2-tr41-dev")
    move Led.rid HASH("ch2-tr41-led")
    jal discoverTrays
    move Tray.rid HASH("ch2-tr42-dev")
    move Led.rid HASH("ch2-tr42-led")
    jal discoverTrays
    move Tray.rid HASH("ch2-tr43-dev")
    move Led.rid HASH("ch2-tr43-led")
    jal discoverTrays
    move Tray.rid HASH("ch2-tr44-dev")
    move Led.rid HASH("ch2-tr44-led")
    jal discoverTrays

    move Tray.rid HASH("ch2-tr51-dev")
    move Led.rid HASH("ch2-tr51-led")
    jal discoverTrays
    move Tray.rid HASH("ch2-tr52-dev")
    move Led.rid HASH("ch2-tr52-led")
    jal discoverTrays
    move Tray.rid HASH("ch2-tr53-dev")
    move Led.rid HASH("ch2-tr53-led")
    jal discoverTrays
    move Tray.rid HASH("ch2-tr54-dev")
    move Led.rid HASH("ch2-tr54-led")
    jal discoverTrays

    move Tray.rid HASH("ch2-tr61-dev")
    move Led.rid HASH("ch2-tr61-led")
    jal discoverTrays
    move Tray.rid HASH("ch2-tr62-dev")
    move Led.rid HASH("ch2-tr62-led")
    jal discoverTrays
    move Tray.rid HASH("ch2-tr63-dev")
    move Led.rid HASH("ch2-tr63-led")
    jal discoverTrays
    move Tray.rid HASH("ch2-tr64-dev")
    move Led.rid HASH("ch2-tr64-led")
    jal discoverTrays

    move Tray.rid HASH("ch2-tr71-dev")
    move Led.rid HASH("ch2-tr71-led")
    jal discoverTrays
    move Tray.rid HASH("ch2-tr72-dev")
    move Led.rid HASH("ch2-tr72-led")
    jal discoverTrays
    move Tray.rid HASH("ch2-tr73-dev")
    move Led.rid HASH("ch2-tr73-led")
    jal discoverTrays
    move Tray.rid HASH("ch2-tr74-dev")
    move Led.rid HASH("ch2-tr74-led")
    jal discoverTrays

    move Tray.rid HASH("ch2-tr81-dev")
    move Led.rid HASH("ch2-tr81-led")
    jal discoverTrays
    move Tray.rid HASH("ch2-tr82-dev")
    move Led.rid HASH("ch2-tr82-led")
    jal discoverTrays
    move Tray.rid HASH("ch2-tr83-dev")
    move Led.rid HASH("ch2-tr83-led")
    jal discoverTrays
    move Tray.rid HASH("ch2-tr84-dev")
    move Led.rid HASH("ch2-tr84-led")
    jal discoverTrays

    sub Count sp Count
    move ra Return
j ra

definePlantState:
    move Clr Color.Black
    ls r15 Tray.rid 0 Occupied
    beqz r15 setLed
    ls r15 Tray.rid 0 Seeding
    brne r15 1 3
        move Clr Color.White
        j setLed 
    ls r15 Tray.rid 0 Efficiency
    brge r15 0.3 3
         move Clr Color.Red
         j setLed
    brge r15 0.7 3
        move Clr Color.Yellow
        j setLed
    brge r15 0.9 3
        move Clr Color.Orange
        j setLed
    brge r15 1 3
        move Clr Color.Green
        j setLed
    move Clr Color.Blue
setLed:
    s Led.rid Color Clr
    sne r15 Clr Color.Black
    s Led.rid On r15
j ra

updateLeds:
    move Return ra
    move sp LISTxTRAYSxADDR
    add sp sp Count
    breq sp LISTxTRAYSxADDR 5
        pop Led.rid
        pop Tray.rid
        jal definePlantState
    jr -4
    move ra Return
j ra
